# 改行は LF に統一（Windows / Linux / Steam Deck 間で差分を出さない）
* text=auto eol=lf

# ── テキストとして扱うもの ──
*.gd        text eol=lf
*.gdshader  text eol=lf
*.tscn      text eol=lf
*.tres      text eol=lf
*.godot     text eol=lf
*.import    text eol=lf
*.cfg       text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.py        text eol=lf
*.html      text eol=lf

# ── バイナリとして扱うもの ──
*.png  binary
*.ogg  binary
*.wav  binary
*.ttf  binary
*.otf  binary
*.fnt  binary

# ── Git LFS 導入方針（この時点では有効化しない） ──
# 手描きのドット絵PNGと音声素材が入り始めた時点で、以下を有効にする。
#   1. `git lfs install` を各開発者が1回実行する
#   2. 下記のコメントを外し、`git lfs track` と同じ内容を .gitattributes で宣言する
#   3. 既にコミット済みの該当ファイルは `git lfs migrate import --include="*.png,*.ogg,*.wav"` で移行する
#      （履歴の書き換えを伴うため、全員の合意を取ってから main で1回だけ行う）
# 判断基準：単体で 1MB を超える素材、または総量が 100MB を超えた時点。
#*.png filter=lfs diff=lfs merge=lfs -text
#*.ogg filter=lfs diff=lfs merge=lfs -text
#*.wav filter=lfs diff=lfs merge=lfs -text
